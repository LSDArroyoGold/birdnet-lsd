# Copiar a config_sincronizacion.txt (sin el .ejemplo) y completar con los
# datos reales del dispositivo. config_sincronizacion.txt NO se commitea
# (ver .gitignore) -- son datos del dispositivo, no del algoritmo.
#
# DRIVE_PATH es el mismo valor que ya vive en config_general.txt de
# LSD-Tector1.1/2.0 (variable DRIVE_PATH) -- se duplica aca porque
# birdnet-lsd es un repo aparte, sin acceso a esos otros config.
RCLONE_CONFIG = /home/lsd/.config/rclone/rclone.conf
DRIVE_REMOTE = gdrive
DRIVE_PATH =
# OJO: sin "/By_Date" al final -- exportador.nombre_archivo() ya arma la
# carpeta_relativa empezando con "By_Date/...", asi que sumarlo aca lo
# duplica (bug real encontrado el 23/08 probando en campo: los archivos
# terminaban en .../By_Date/By_Date/<fecha>/... en vez de .../By_Date/<fecha>/...).
AUDIO_ROOT = /home/lsd/BirdSongs/Extracted
